{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@defjs/core": ["./packages/core/src"],
      "@defjs/opentelemetry-server": ["./packages/opentelemetry-server/src"],
      "@defjs/react": ["./packages/react/src"],
      "@defjs/vue": ["./packages/vue/src"]
    }
  },
  "include": ["*.ts", "*.mts", "*.cts", "test/**/*.ts", "packages/**/*.ts", "examples/**/*.ts", "doc/.vitepress/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "**/coverage", "doc/.vitepress/cache", "doc/.vitepress/dist"]
}
