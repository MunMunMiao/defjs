{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "test",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.type.test.ts",
    "src/**/*.browser.spec.ts",
    "src/**/*.browser.spec.tsx"
  ]
}
