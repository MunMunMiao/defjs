{
  "name": "@defjs/core",
  "version": "0.3.1",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "license": "MIT",
  "publishConfig": {
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test:bun": "vitest run --config vitest.config.bun.ts",
    "test:browser:chrome": "vitest run --config vitest.config.browser.chrome.ts",
    "test:browser:firefox": "vitest run --config vitest.config.browser.firefox.ts",
    "test:browser:safari": "vitest run --config vitest.config.browser.safari.ts",
    "test:deno": "vitest run --config vitest.config.deno.ts",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:schema": "vitest run --config vitest.schema.config.ts",
    "test:schema:types": "tsc -p tsconfig.schema.json",
    "pub": "cd dist && bun publish"
  }
}
