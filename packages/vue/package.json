{
  "name": "@defjs/vue",
  "version": "1.0.0",
  "type": "module",
  "module": "dist/index.js",
  "typings": "dist/index.d.ts",
  "license": "MIT",
  "peerDependencies": {
    "vue": ">=3.0.0",
    "@defjs/core": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pub": "bun publish dist",
    "test:chrome": "bun x vitest run --config vitest.config.browser.chrome.ts",
    "test:firefox": "bun x vitest run --config vitest.config.browser.firefox.ts",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  }
}
