{
  "name": "defjs",
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@types/bun": "^1.3.11",
    "@vitest/browser": "^4.1.1",
    "@vitest/browser-webdriverio": "^4.1.1",
    "@vitest/coverage-istanbul": "^4.1.1",
    "@vitest/ui": "^4.1.1",
    "bun-plugin-dts": "^0.4.0",
    "hono": "^4.12.9",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.1",
    "webdriverio": "^9.20.0"
  },
  "scripts": {
    "build": "bun --filter '@defjs/core' build",
    "lint": "bun --filter '@defjs/core' lint",
    "lint:fix": "bun --filter '@defjs/core' lint:fix",
    "test": "vitest run --project core-node",
    "test:all": "vitest run --project core-node --project core-bun-compat --project core-deno-compat --project core-browser-chrome --project core-browser-firefox",
    "test:browser:chrome": "vitest run --project core-browser-chrome",
    "test:browser:firefox": "vitest run --project core-browser-firefox",
    "test:browser:safari": "vitest run --project core-browser-safari",
    "test:browsers": "vitest run --project core-browser-chrome --project core-browser-firefox",
    "test:bun": "vitest run --project core-bun-compat",
    "test:deno": "vitest run --project core-deno-compat",
    "test:node": "vitest run --project core-node",
    "test:runtime": "vitest run --project core-node --project core-bun-compat --project core-deno-compat",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "test:all:macos": "vitest run --project core-browser-safari"
  }
}
