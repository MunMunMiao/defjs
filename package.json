{
  "name": "defjs",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "doc"
    ],
    "catalog": {
      "@hono/node-server": "^2.0.11",
      "@hono/node-ws": "^1.3.1",
      "@types/bun": "1.4.0",
      "@vitest/browser": "^4.1.10",
      "@vitest/browser-playwright": "^4.1.10",
      "@vitest/coverage-istanbul": "^4.1.10",
      "hono": "^4.12.32",
      "oxfmt": "0.60.0",
      "oxlint": "1.75.0",
      "oxlint-tsgolint": "7.0.2001",
      "playwright": "^1.62.0",
      "tsdown": "^0.22.14",
      "typescript": "^7.0.2",
      "vite": "^8.1.5",
      "vitest": "^4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run --workspaces --if-present build",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun run --sequential --workspaces --if-present test",
    "test:packed": "bun scripts/verify-packed-consumer.ts",
    "test:release": "bun test scripts/release-target.spec.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify": "bun run lint && bun run fmt:check && bun run test:release && bun run test && bun run build && bun run test:packed"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@types/bun": "catalog:",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "vite": "^8.1.5"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
